# --- Data (Kaggle competition data cannot be redistributed) ---
data/raw/*.csv
data/processed/*.csv
data/raw/*.xls
data/raw/*.xlsx
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Trained model artifacts (can be large / regenerated from code) ---
models/*.pkl
models/*.joblib
models/*.json
!models/.gitkeep

# --- Reports / generated figures ---
# The 4 images embedded directly in README.md ARE committed (so the README
# renders correctly on GitHub); everything else in reports/figures/ stays
# ignored since it's regenerated by src.evaluate / src.inference.
reports/figures/*.png
!reports/figures/roc_pr_curves.png
!reports/figures/threshold_cost_curve.png
!reports/figures/confusion_matrix.png
!reports/figures/shap_summary.png
reports/figures/*.svg
!reports/figures/.gitkeep

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Optuna study storage (local sqlite db) ---
# reports/optuna_study.db IS committed -- README points to it as an
# inspectable artifact (`optuna-dashboard sqlite:///reports/optuna_study.db`).
*.db
!reports/optuna_study.db
optuna_studies/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Env / secrets ---
.env